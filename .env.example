# Copy to .env to override defaults. Development credentials only.
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench

STORAGE_BUCKET=tensor-workbench
STORAGE_ACCESS_KEY=workbench-dev
STORAGE_SECRET_KEY=workbench-dev-secret
# Browser-reachable S3 endpoint used to sign download URLs.
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_PUBLIC_PORT=8333

WORKER_TOKEN=dev-worker-token
WORKER_SLOTS=3
# Synthetic seconds added to each computation so scheduling is visible. 0 = raw speed.
WORKER_SYNTHETIC_DELAY_SECONDS=3

QUEUE_LEASE_DURATION=15s
QUEUE_HEARTBEAT_INTERVAL=5s
QUEUE_MAX_ATTEMPTS=3
ALLOW_FAULT_INJECTION=true

WEB_PORT=3000
